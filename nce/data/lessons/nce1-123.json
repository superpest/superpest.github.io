{"id":"nce1-123","book":"nce1","numbers":[123,124],"label":"Lesson 123–124","titleEn":"A Trip to Australia","titleCn":"澳大利亚之行","audio":"media/lessons/nce1/123.mp3","lines":[{"t":4.0,"en":"A trip to Australia","cn":"澳大利亚之旅"},{"t":7.35,"en":"Listen to the tape then answer this question.","cn":"听完录音后，请回答这个问题："},{"t":12.94,"en":"Who is the man with the beard?","cn":"那个留着胡子的男人是谁？"},{"t":17.83,"en":"Look, Scott.","cn":"看，斯科特。"},{"t":19.99,"en":"This is a photograph I took during my trip to Australia.","cn":"这是我在澳大利亚旅行时拍的照片。"},{"t":26.64,"en":"Let me see it, Mike.","cn":"让我看看，迈克。"},{"t":29.24,"en":"This is a good photograph.","cn":"这张照片真不错！"},{"t":31.95,"en":"Who are these people?","cn":"这些人是谁？"},{"t":35.04,"en":"They're people I met during the trip.","cn":"他们是我在旅行中遇到的人。"},{"t":39.49,"en":"That's the ship we travelled on.","cn":"那就是我们乘坐的船。"},{"t":42.39,"en":"What a beautiful ship!","cn":"多漂亮的船啊！"},{"t":45.01,"en":"Who's this?","cn":"“这是谁？”"},{"t":47.12,"en":"That's the man I told you about.","cn":"“就是我跟你提过的那个人。”"},{"t":50.19,"en":"Remember?","cn":"“记得吗？”"},{"t":51.58,"en":"Ah yes.","cn":"“啊，对。”"},{"t":53.1,"en":"The one who offered you a job in Australia.","cn":"“就是那个在澳大利亚给你提供工作机会的人。”"},{"t":57.44,"en":"That's right.","cn":"“没错。”"},{"t":58.9,"en":"Who's this?","cn":"“这是谁？”"},{"t":60.64,"en":"Guess!","cn":"“猜猜看！”"},{"t":61.74,"en":"It's not you, is it?","cn":"“肯定不是你吧？”"},{"t":64.17,"en":"That's right.","cn":"“没错。”"},{"t":66.73,"en":"I grew a beard during the trip, but I shaved it off when I came home.","cn":"“我在旅途中留了胡子，但回家后就把它刮掉了。”"},{"t":73.5,"en":"Why did you shave it off?","cn":"“你为什么要刮掉胡子呢？”"},{"t":76.16,"en":"My wife didn't like it!","cn":"我妻子不喜欢它！"}],"words":[{"word":"during","phonetic":["'djuəriŋ"],"pos":"prep.","meaning":"在…期间","us":"media/words/nce1/w0781_a.mp3","uk":"media/words/nce1/w0781_e.mp3"},{"word":"trip","phonetic":["trip"],"pos":"n.","meaning":"旅行","us":"media/words/nce1/w0782_a.mp3","uk":"media/words/nce1/w0782_e.mp3"},{"word":"travel","phonetic":["'trævəl"],"pos":"v.","meaning":"旅行","us":"media/words/nce1/w0783_a.mp3","uk":"media/words/nce1/w0783_e.mp3"},{"word":"offer","phonetic":["'ɔfə"],"pos":"v.","meaning":"提供","us":"media/words/nce1/w0784_a.mp3","uk":"media/words/nce1/w0784_e.mp3"},{"word":"job","phonetic":["dʒɔb"],"pos":"n.","meaning":"工作","us":"media/words/nce1/w0070_a.mp3","uk":"media/words/nce1/w0070_e.mp3"},{"word":"guess","phonetic":["ges"],"pos":"v.","meaning":"猜","us":"media/words/nce1/w0785_a.mp3","uk":"media/words/nce1/w0785_e.mp3"},{"word":"grow","phonetic":["grəu"],"pos":"v.","meaning":"长，让…生长","us":"media/words/nce1/w0786_a.mp3","uk":"media/words/nce1/w0786_e.mp3"},{"word":"beard","phonetic":["biəd"],"pos":"n.","meaning":"(下巴上的)胡子，络腮胡子","us":"media/words/nce1/w0787_a.mp3","uk":"media/words/nce1/w0787_e.mp3"},{"word":"kitten","phonetic":["'kitn"],"pos":"n.","meaning":"小猫","us":"media/words/nce1/w0788_a.mp3","uk":"media/words/nce1/w0788_e.mp3"}]}