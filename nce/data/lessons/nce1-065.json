{"id":"nce1-065","book":"nce1","numbers":[65,66],"label":"Lesson 65–66","titleEn":"Not a Baby","titleCn":"我不是小孩","audio":"media/lessons/nce1/065.mp3","lines":[{"t":3.35,"en":"Not a baby","cn":"我可不是小孩子了。"},{"t":6.25,"en":"Listen to the tape then answer this question.","cn":"先听这段录音，然后再回答这个问题。"},{"t":11.58,"en":"Does Jill take the key to the front door?","cn":"吉尔会拿前门的钥匙吗？"},{"t":17.67,"en":"What are you going to do this evening, Jill?","cn":"今晚你打算做什么，吉尔？"},{"t":22.63,"en":"I'm going to meet some friends, Dad.","cn":"爸爸，我要去见一些朋友。"},{"t":27.15,"en":"You mustn't come home late.","cn":"你千万不要回家太晚。"},{"t":30.19,"en":"You must be home at half past ten.","cn":"你必须在十点半之前到家。"},{"t":34.87,"en":"I can't get home so early, Dad!","cn":"爸爸，我没办法这么早就回家啊！"},{"t":39.41,"en":"Can I have the key to the front door, please?","cn":"请问，能给我前门的钥匙吗？"},{"t":44.48,"en":"No, you can't.","cn":"不，你不能。"},{"t":47.61,"en":"Jill's eighteen years old, Tom.","cn":"吉尔已经十八岁了，汤姆。"},{"t":51.89,"en":"She's not a baby.","cn":"她已经不是小孩子了。"},{"t":54.74,"en":"Give her the key.","cn":"把钥匙给她。"},{"t":56.98,"en":"She always comes home early.","cn":"她总是很早就回家。"},{"t":61.08,"en":"Oh, all right!","cn":"哦，好吧！"},{"t":64.45,"en":"Here you are.","cn":"给你。"},{"t":66.27,"en":"But you mustn't come home after a quarter past eleven.","cn":"但是你绝对不能在十一点四十五分之后才回家。"},{"t":71.52,"en":"Do you hear?","cn":"你听到了吗？"},{"t":73.57,"en":"Yes, Dad.","cn":"是的，爸爸。"},{"t":75.82,"en":"Thanks, Mum.","cn":"谢谢，妈妈。"},{"t":77.81,"en":"That's all right.","cn":"那好吧。"},{"t":79.92,"en":"Goodbye.","cn":"再见。"},{"t":81.52,"en":"Enjoy yourself!","cn":"玩得开心！"},{"t":84.39,"en":"We always enjoy ourselves, Mum.","cn":"我们总是玩得很开心，妈妈。"},{"t":88.3,"en":"Bye-bye.","cn":"再见。"}],"words":[{"word":"Dad","phonetic":["dæd"],"pos":"n.","meaning":"爸(儿语)","us":null,"uk":null},{"word":"key","phonetic":["ki:"],"pos":"n.","meaning":"钥匙","us":"media/words/nce1/w0511_a.mp3","uk":"media/words/nce1/w0511_e.mp3"},{"word":"baby","phonetic":["'beibi"],"pos":"n.","meaning":"婴儿","us":"media/words/nce1/w0512_a.mp3","uk":"media/words/nce1/w0512_e.mp3"},{"word":"hear","phonetic":["hiə"],"pos":"v.","meaning":"听见","us":"media/words/nce1/w0513_a.mp3","uk":"media/words/nce1/w0513_e.mp3"},{"word":"enjoy","phonetic":["in'dʒɔi"],"pos":"v.","meaning":"玩得快活","us":"media/words/nce1/w0514_a.mp3","uk":"media/words/nce1/w0514_e.mp3"},{"word":"yourself","phonetic":["jə'self"],"pos":"pron.","meaning":"你自己","us":"media/words/nce1/w0515_a.mp3","uk":"media/words/nce1/w0515_e.mp3"},{"word":"ourselves","phonetic":["auə'selvz"],"pos":"pron.","meaning":"我们自己","us":"media/words/nce1/w0516_a.mp3","uk":"media/words/nce1/w0516_e.mp3"},{"word":"myself","phonetic":["mai'self"],"pos":"pron.","meaning":"我自己","us":"media/words/nce1/w0517_a.mp3","uk":"media/words/nce1/w0517_e.mp3"},{"word":"themselves","phonetic":["ðəm'selvz"],"pos":"pron.","meaning":"他们自己","us":"media/words/nce1/w0518_a.mp3","uk":"media/words/nce1/w0518_e.mp3"},{"word":"himself","phonetic":["him'self"],"pos":"pron.","meaning":"他自己","us":"media/words/nce1/w0519_a.mp3","uk":"media/words/nce1/w0519_e.mp3"},{"word":"herself","phonetic":["hə:'self"],"pos":"pron.","meaning":"她自己","us":"media/words/nce1/w0520_a.mp3","uk":"media/words/nce1/w0520_e.mp3"}]}