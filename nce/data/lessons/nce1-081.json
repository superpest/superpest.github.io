{"id":"nce1-081","book":"nce1","numbers":[81,82],"label":"Lesson 81–82","titleEn":"Roast Beef and Potatoes","titleCn":"烤牛肉和土豆","audio":"media/lessons/nce1/081.mp3","lines":[{"t":3.05,"en":"Roast beef and potatoes","cn":"烤牛肉配土豆"},{"t":6.92,"en":"Listen to the tape then answer this question.","cn":"听完录音后回答这个问题："},{"t":12.41,"en":"Why is Carol disappointed?","cn":"为什么卡罗尔感到失望？"},{"t":17.01,"en":"Hi, Carol! Where's Tom?","cn":"嗨，Carol！Tom在哪儿？"},{"t":20.33,"en":"He's upstairs.","cn":"嗨，卡罗尔！汤姆在哪儿？"},{"t":22.39,"en":"He's having a bath.","cn":"他在楼上，正在洗澡。"},{"t":24.6,"en":"Tom!","cn":"汤姆！"},{"t":26.78,"en":"Yes?","cn":"在吗？"},{"t":28.28,"en":"Sam's here.","cn":"山姆来了。"},{"t":30.15,"en":"I'm nearly ready.","cn":"我差不多准备好了。"},{"t":32.84,"en":"Hello, Sam.","cn":"你好，山姆。"},{"t":34.69,"en":"Have a cigarette.","cn":"来一支烟吧。"},{"t":36.59,"en":"No, thanks, Tom.","cn":"不，谢谢，汤姆。"},{"t":39.06,"en":"Have a glass of whisky then.","cn":"那就喝一杯威士忌吧。"},{"t":41.7,"en":"OK.","cn":"好的。"},{"t":42.58,"en":"Thanks.","cn":"谢谢。"},{"t":44.18,"en":"Is dinnner ready, Carol?","cn":"卡罗尔，晚餐准备好了吗？"},{"t":47.84,"en":"It's nearly ready.","cn":"它差不多准备好了。"},{"t":50.12,"en":"We can have dinner at seven o'clock.","cn":"我们可以在七点钟吃晚饭。"},{"t":54.8,"en":"Sam and I had lunch together today.","cn":"今天我和山姆一起吃了午饭。"},{"t":58.63,"en":"We went to a restaurant.","cn":"我们去了餐厅。"},{"t":61.3,"en":"What did you have?","cn":"你吃了什么？"},{"t":63.42,"en":"We had roast beef and potatoes.","cn":"我们吃了烤牛肉和土豆。"},{"t":67.49,"en":"Oh!","cn":"哦！"},{"t":68.71,"en":"What's the matter, Carol?","cn":"怎么了，卡罗尔？"},{"t":71.05,"en":"Well, you're going to have roast beef and potatoes again tonight!","cn":"嗯，今晚你又可以吃烤牛肉和土豆了！"}],"words":[{"word":"bath","phonetic":["bɑ:θ"],"pos":"n.","meaning":"洗澡","us":"media/words/nce1/w0594_a.mp3","uk":"media/words/nce1/w0594_e.mp3"},{"word":"nearly","phonetic":["'niəli"],"pos":"ad.","meaning":"几乎，将近","us":"media/words/nce1/w0595_a.mp3","uk":"media/words/nce1/w0595_e.mp3"},{"word":"ready","phonetic":["'redi"],"pos":"a.","mean