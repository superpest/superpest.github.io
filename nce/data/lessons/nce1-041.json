{"id":"nce1-041","book":"nce1","numbers":[41,42],"label":"Lesson 41–42","titleEn":"Penny's Bag","titleCn":"彭妮的提包","audio":"media/lessons/nce1/041.mp3","lines":[{"t":2.9,"en":"Penny's bag","cn":"佩妮的包"},{"t":5.69,"en":"Listen to the tape then answer this question.","cn":"先听这段录音，然后再回答这个问题。"},{"t":11.88,"en":"Who is the tin of tobacco for?","cn":"这罐烟草是给谁用的呢？"},{"t":17.89,"en":"Is that bag heavy, Penny?","cn":"那个包很重吗，Penny？"},{"t":20.83,"en":"Not very.","cn":"不太好。"},{"t":23.0,"en":"Here!","cn":"给你！"},{"t":24.3,"en":"Put it on this chair.","cn":"把它放在这把椅子上。"},{"t":27.12,"en":"What's in it?","cn":"里面有什么？"},{"t":29.27,"en":"A piece of cheese.","cn":"一块奶酪。"},{"t":32.14,"en":"A loaf of bread.","cn":"一条面包。"},{"t":34.77,"en":"A bar of soap.","cn":"一块肥皂。"},{"t":37.52,"en":"A bar of chocolate.","cn":"一块巧克力。"},{"t":40.19,"en":"A bottle of milk.","cn":"一瓶牛奶。"},{"t":42.77,"en":"A pound of sugar.","cn":"一磅糖。"},{"t":45.74,"en":"Half a pound of coffee.","cn":"半磅咖啡。"},{"t":49.17,"en":"A quarter of a pound of tea.","cn":"四分之一磅茶。"},{"t":53.12,"en":"And a tin of tobacco.","cn":"还有一罐烟草。"},{"t":57.57,"en":"Is that tin of tobacco for me?","cn":"那罐烟草是给我的吗？"},{"t":62.07,"en":"Well, it's certainly not for me!","cn":"嗯，那肯定不是给我的！"}],"words":[{"word":"cheese","phonetic":["tʃi:z"],"pos":"n.","meaning":"乳酪，干酪","us":"media/words/nce1/w0313_a.mp3","uk":"media/words/nce1/w0313_e.mp3"},{"word":"bread","phonetic":["bred"],"pos":"n.","meaning":"面包","us":"media/words/nce1/w0314_a.mp3","uk":"media/words/nce1/w0314_e.mp3"},{"word":"soap","phonetic":["səup"],"pos":"n.","meaning":"肥皂","us":"media/words/nce1/w0315_a.mp3","uk":"media/words/nce1/w0315_e.mp3"},{"word":"chocolate","phonetic":["'tʃɔklit"],"pos":"n.","meaning":"巧克力","us":"media/words/nce1/w0316_a.mp3","uk":"media/words/nce1/w0316_e.mp3"},{"word":"sugar","phonetic":["'ʃugə"],"pos":"n.","meaning":"糖","us":"media/words/nce1/w0317_a.mp3","uk":"media/words/nce1/w0317_e.mp3"},{"word":"coffee","phonetic":["'kɔfi"],"pos":"n.","meaning":"咖啡","us":"media/words/n