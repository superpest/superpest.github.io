{"id":"nce1-099","book":"nce1","numbers":[99,100],"label":"Lesson 99–100","titleEn":"Ow!","titleCn":"啊哟！","audio":"media/lessons/nce1/099.mp3","lines":[{"t":2.85,"en":"Ow!","cn":"哎哟！"},{"t":4.74,"en":"Listen to the tape then answer this question.","cn":"先听一下录音，然后回答这个问题："},{"t":10.49,"en":"Must Andy go to see the doctor?","cn":"安迪必须去看医生吗？"},{"t":15.56,"en":"Ow!","cn":"哎哟！"},{"t":17.05,"en":"What's the matter, Andy?","cn":"怎么了，安迪？"},{"t":20.06,"en":"I slipped and fell downstairs.","cn":"我在楼下滑倒了。"},{"t":23.62,"en":"Have you hurt yourself?","cn":"你受伤了吗？"},{"t":26.46,"en":"Yes, I have.","cn":"是的，我受伤了。"},{"t":28.48,"en":"I think that I've hurt my back.","cn":"我觉得我的背部受了伤。"},{"t":32.54,"en":"Try and stand up.","cn":"试着站起来吧。"},{"t":35.29,"en":"Can you stand up?","cn":"你能站起来吗？"},{"t":37.45,"en":"Here.","cn":"给你。"},{"t":38.53,"en":"Let me help you.","cn":"让我来帮你吧。"},{"t":41.51,"en":"I'm sorry, Lucy.","cn":"对不起，露西。"},{"t":43.99,"en":"I'm afraid that I can't get up.","cn":"恐怕我无法起床了。"},{"t":48.04,"en":"I think that the doctor had better see you.","cn":"我觉得医生最好还是见见你。"},{"t":52.97,"en":"I'll phone Dr. Carter.","cn":"我会给卡特医生打电话。"},{"t":56.97,"en":"The doctor says that he will come at once.","cn":"医生说他会立刻过来。"},{"t":61.83,"en":"I'm sure that you need an X-ray, Andy.","cn":"我肯定你需要做一次X光检查，安迪。"}],"words":[{"word":"ow","phonetic":["au"],"pos":"int.","meaning":"哎哟","us":"media/words/nce1/w0668_a.mp3","uk":"media/words/nce1/w0668_e.mp3"},{"word":"slip","phonetic":["slip"],"pos":"v.","meaning":"滑倒，滑了一脚","us":"media/words/nce1/w0669_a.mp3","uk":"media/words/nce1/w0669_e.mp3"},{"word":"fall","phonetic":["fɔ:l"],"pos":"v.","meaning":"落下，跌倒","us":"media/words/nce1/w0670_a.mp3","uk":"media/words/nce1/w0670_e.mp3"},{"word":"downstairs","phonetic":["ˌdaun'steəz"],"pos":"ad.","meaning":"下楼","us":"media/words/nce1/w0671_a.mp3","uk":"media/words/nce1/w0671_e.mp3"},{"word":"hurt","phonetic":["hə:t"],"pos":"v.","meaning":"伤，伤害，疼痛","us":"media/words/nce1/w0672_a.mp3","uk":"media/words/nce1/w0672_e.mp3"},{