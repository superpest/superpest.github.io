{"id":"nce1-013","book":"nce1","numbers":[13,14],"label":"Lesson 13–14","titleEn":"A New Dress","titleCn":"一件新连衣裙","audio":"media/lessons/nce1/013.mp3","lines":[{"t":2.71,"en":"A new dress","cn":"一条新裙子"},{"t":5.53,"en":"Listen to the tape then answer this question.","cn":"先听这段录音，然后再回答这个问题。"},{"t":11.72,"en":"What colour is Anna's hat?","cn":"安娜的帽子是什么颜色的？"},{"t":16.67,"en":"What colour's your new dress?","cn":"你的新裙子是什么颜色的？"},{"t":20.46,"en":"It's green.","cn":"它是绿色的。"},{"t":22.52,"en":"Come upstairs and see it.","cn":"上来看看吧。"},{"t":25.78,"en":"Thank you.","cn":"谢谢。"},{"t":27.53,"en":"Look!","cn":"看！"},{"t":28.66,"en":"Here it is!","cn":"好了，它来了！"},{"t":30.79,"en":"That's a nice dress.","cn":"那条裙子真漂亮。"},{"t":33.51,"en":"It's very smart.","cn":"它非常聪明。"},{"t":36.16,"en":"My hat's new too.","cn":"我的帽子也是新买的。"},{"t":39.22,"en":"What colour is it?","cn":"它是什么颜色的？"},{"t":41.62,"en":"It's the same colour.","cn":"它的颜色和我的帽子一样。"},{"t":44.18,"en":"It's green  too.","cn":"也是绿色的。"},{"t":47.12,"en":"That is a lovely hat!","cn":"那是一顶非常漂亮的帽子！"}],"words":[{"word":"colour","phonetic":["'kʌlə"],"pos":"n.","meaning":"颜色","us":"media/words/nce1/w0119_a.mp3","uk":"media/words/nce1/w0119_e.mp3"},{"word":"green","phonetic":["gri:n"],"pos":"a.","meaning":"绿色","us":"media/words/nce1/w0120_a.mp3","uk":"media/words/nce1/w0120_e.mp3"},{"word":"come","phonetic":["kʌm"],"pos":"v.","meaning":"来","us":"media/words/nce1/w0121_a.mp3","uk":"media/words/nce1/w0121_e.mp3"},{"word":"upstairs","phonetic":["ˌʌp'steəz"],"pos":"ad.","meaning":"楼上","us":"media/words/nce1/w0122_a.mp3","uk":"media/words/nce1/w0122_e.mp3"},{"word":"smart","phonetic":["smɑ:t"],"pos":"a.","meaning":"时髦的，巧妙的","us":"media/words/nce1/w0123_a.mp3","uk":"media/words/nce1/w0123_e.mp3"},{"word":"hat","phonetic":["hæt"],"pos":"n.","meaning":"帽子","us":"media/words/nce1/w0124_a.mp3","uk":"media/words/nce1/w0124_e.mp3"},{"word":"same","phonetic":["seim"],"pos":"a.","meaning":"相同的","us":"media/words/nce1/w0125_a.mp3","uk":"media/words/nce1/w0125_