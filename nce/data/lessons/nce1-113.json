{"id":"nce1-113","book":"nce1","numbers":[113,114],"label":"Lesson 113–114","titleEn":"Small Change","titleCn":"零钱","audio":"media/lessons/nce1/113.mp3","lines":[{"t":3.88,"en":"Small change","cn":"零钱；小额货币"},{"t":6.48,"en":"Listen to the tape then answer this question.","cn":"先听这段录音，然后再回答这个问题。"},{"t":11.98,"en":"Who has got some small change?","cn":"谁有零钱吗？"},{"t":17.39,"en":"Fares, please!","cn":"请告诉我票价是多少！"},{"t":19.07,"en":"Trafalgar Square, please.","cn":"请去特拉法尔加广场。"},{"t":21.54,"en":"I'm sorry, sir.","cn":"对不起，先生。"},{"t":24.17,"en":"I can't change a ten-pound note.","cn":"我无法兑换一张十英镑的纸币。"},{"t":28.14,"en":"Haven't you got any small change?","cn":"你没有零钱吗？"},{"t":31.97,"en":"I've got no small change,","cn":"我没有零钱了。"},{"t":34.53,"en":"I am afraid.","cn":"我很害怕。"},{"t":36.51,"en":"I'll ask some of the passengers.","cn":"我会去问问一些乘客。"},{"t":40.19,"en":"Have you any small change, sir?","cn":"先生，您有零钱吗？"},{"t":43.64,"en":"I'm sorry.","cn":"对不起。"},{"t":44.96,"en":"I've got none.","cn":"我一个都没有。"},{"t":48.01,"en":"I haven't got any either.","cn":"我一个也没有。"},{"t":51.8,"en":"Can you change this ten-pound note, madam?","cn":"女士，您能帮我兑换这张十英镑的纸币吗？"},{"t":56.84,"en":"I'm afraid I can't.","cn":"恐怕我做不到。"},{"t":60.13,"en":"Neither can I.","cn":"我也不知道。"},{"t":62.94,"en":"I'm very sorry, sir.","cn":"非常抱歉，先生。"},{"t":65.29,"en":"You must get off the bus.","cn":"你必须下车。"},{"t":68.54,"en":"None of our passengers can change this note.","cn":"我们的任何乘客都无法更改这条留言。"},{"t":73.63,"en":"They're all millionaires!","cn":"他们都是百万富翁！"},{"t":76.36,"en":"Except us.","cn":"除了我们之外。"},{"t":79.36,"en":"I've got some small change.","cn":"我有一些零钱。"},{"t":82.96,"en":"So have I.","cn":"我也是。"}],"words":[{"word":"conductor","phonetic":["kən'dʌktə"],"pos":"n.","meaning":"售票员","us":"media/words/nce1/w0739_a.mp3","uk":"media/words/nce1/w0739_e.mp3"},{"word":"fare","phonetic":["feə"],"pos":"n.","meaning":"车费，车票","us":"media/words/nce1/w0740_a.mp3","uk":"media/words/nce1/w0740_e.mp3"},{"word":"change","phonetic":["tʃeindʒ"],"p