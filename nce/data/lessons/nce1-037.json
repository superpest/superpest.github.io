{"id":"nce1-037","book":"nce1","numbers":[37,38],"label":"Lesson 37–38","titleEn":"Making a Bookcase","titleCn":"做书架","audio":"media/lessons/nce1/037.mp3","lines":[{"t":3.05,"en":"Making a bookcase","cn":"制作一个书架"},{"t":6.11,"en":"Listen to the tape then answer this question.","cn":"先听这段录音，然后再回答这个问题。"},{"t":12.3,"en":"What is Susan's favourite colour?","cn":"苏珊最喜欢的颜色是什么？"},{"t":17.45,"en":"You're working hard, George.","cn":"你工作得很努力，乔治。"},{"t":20.72,"en":"What are you doing?","cn":"你在做什么？"},{"t":23.22,"en":"I'm making a bookcase.","cn":"我正在制作一个书架。"},{"t":26.81,"en":"Give me that hammer please, Dan.","cn":"请把那把锤子递给我，丹。"},{"t":30.82,"en":"Which hammer?","cn":"哪把锤子？"},{"t":32.64,"en":"This one?","cn":"这个吗？"},{"t":34.12,"en":"No, not that one.","cn":"不，不是那个。"},{"t":36.53,"en":"The big one.","cn":"那个重要的（或大型的）东西。"},{"t":38.94,"en":"Here you are.","cn":"给你。"},{"t":40.56,"en":"Thanks, Dan.","cn":"谢谢，丹。"},{"t":43.51,"en":"What are you going to do now, George?","cn":"乔治，你现在打算做什么？"},{"t":47.84,"en":"I'm going to paint it.","cn":"我打算把它画出来。"},{"t":51.12,"en":"What colour are you going to paint it?","cn":"你打算把它涂成什么颜色？"},{"t":55.48,"en":"I'm going to paint it pink.","cn":"我打算把它涂成粉色。"},{"t":59.5,"en":"Pink!","cn":"粉色！"},{"t":60.99,"en":"This bookcase isn't for me.","cn":"这个书架不适合我。"},{"t":63.96,"en":"It's for my daughter, Susan.","cn":"这是给我女儿苏珊的。"},{"t":67.1,"en":"Pink's her favourite colour.","cn":"粉色是她最喜欢的颜色。"}],"words":[{"word":"work","phonetic":["wə:k"],"pos":"v.","meaning":"工作","us":"media/words/nce1/w0294_a.mp3","uk":"media/words/nce1/w0294_e.mp3"},{"word":"hard","phonetic":["'hɑ:d"],"pos":"ad.","meaning":"努力地","us":"media/words/nce1/w0295_a.mp3","uk":"media/words/nce1/w0295_e.mp3"},{"word":"make","phonetic":["meik"],"pos":"v.","meaning":"做","us":"media/words/nce1/w0051_a.mp3","uk":"media/words/nce1/w0051_e.mp3"},{"word":"bookcase","phonetic":["'buk-keis"],"pos":"n.","meaning":"书橱，书架","us":"media/words/nce1/w0296_a.mp3","uk":"media/words/nce1/w0296_e.mp3"},{"word":"hammer","phonetic":["'hæmə"],"pos":"n.","meaning":"锤子","us":"media/words/nce1/w0297_a.mp3","uk":"media/words/nce1/w0297_e.mp3"},{"word":"paint","phonetic":["peint"],"pos":"v.","meaning":"上漆，涂","us":"media/words/nce1/w0298_a.mp3","uk":"media/words/nce1/w0298_e.mp3"},{"word":"pink","phonetic":["piŋk"],"pos":"n.& a.","meaning":"粉红色","us":"media/words/nce1/w0299_a.mp3","uk":"media/words/nce1/w0299_e.mp3"},{"word":"favourite","phonetic":["'feivərit"],"pos":"a.","meaning":"最喜欢的","us":"media/words/nce1/w0300_a.mp3","uk":"media/words/nce1/w0300_e.mp3"},{"word":"homework","phonetic":["'həumwə:k"],"pos":"n.","meaning":"作业","us":"media/words/nce1/w0301_a.mp3","uk":"media/words/nce1/w0301_e.mp3"},{"word":"listen","phonetic":["'lisən"],"pos":"v.","meaning":"听","us":"media/words/nce1/w0302_a.mp3","uk":"media/words/nce1/w0302_e.mp3"},{"word":"dish","phonetic":["diʃ"],"pos":"n.","meaning":"盘子，碟子","us":"media/words/nce1/w0303_a.mp3","uk":"media/words/nce1/w0303_e.mp3"}]}