{"id":"nce1-039","book":"nce1","numbers":[39,40],"label":"Lesson 39–40","titleEn":"Don't Drop It!","titleCn":"别摔了！","audio":"media/lessons/nce1/039.mp3","lines":[{"t":3.11,"en":"Don't drop it!","cn":"别把它掉下来！"},{"t":6.28,"en":"Listen to the tape then answer this question.","cn":"先听录音，然后回答这个问题："},{"t":12.44,"en":"Where does Sam put the vase in the end?","cn":"最后萨姆把花瓶放在了哪里？"},{"t":18.55,"en":"What are you going to do with that vase, Penny?","cn":"佩妮，你打算怎么处理那个花瓶？"},{"t":24.02,"en":"I'm going to put it on this table, Sam.","cn":"“我要把它放在这张桌子上，”萨姆说。"},{"t":29.15,"en":"Don't do that.","cn":"“别那么做！”"},{"t":31.31,"en":"Give it to me.","cn":"“把它给我吧。”"},{"t":33.63,"en":"What are you going to do with it?","cn":"“你到底打算怎么处理它？”"},{"t":37.39,"en":"I'm going to put it here, in front of the window.","cn":"“我要把它放在这里，窗子前面。”"},{"t":43.03,"en":"Be careful! Don't drop it!","cn":"“小心点！别把它掉下来！”"},{"t":47.32,"en":"Don't put it there, Sam.","cn":"“别放在那儿，萨姆。”"},{"t":50.31,"en":"Put it here, on this shelf.","cn":"把它放在这里，这个架子上。"},{"t":54.7,"en":"There we are!","cn":"好了，放好了！"},{"t":56.74,"en":"It's a lovely vase.","cn":"这是一个很漂亮的花瓶。"},{"t":59.47,"en":"Those flowers are lovely, too.","cn":"那些花也很漂亮。"}],"words":[{"word":"front","phonetic":["frʌnt"],"pos":"n.","meaning":"前面","us":"media/words/nce1/w0304_a.mp3","uk":"media/words/nce1/w0304_e.mp3"},{"word":"in front of","phonetic":[],"pos":"","meaning":"在…之前","us":"media/words/nce1/w0305_a.mp3","uk":"media/words/nce1/w0305_e.mp3"},{"word":"careful","phonetic":["'keəful"],"pos":"a.","meaning":"小心的，仔细的","us":"media/words/nce1/w0306_a.mp3","uk":"media/words/nce1/w0306_e.mp3"},{"word":"vase","phonetic":["vɑ:z","veis","veiz"],"pos":"n.","meaning":"花瓶","us":"media/words/nce1/w0307_a.mp3","uk":"media/words/nce1/w0307_e.mp3"},{"word":"drop","phonetic":["drɔp"],"pos":"v.","meaning":"掉下","us":"media/words/nce1/w0308_a.mp3","uk":"media/words/nce1/w0308_e.mp3"},{"word":"flower","phonetic":["'flauə"],"pos":"n.","meaning":"花","us":"media/words/nce1/w0309_a.mp3","uk":"