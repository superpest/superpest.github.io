{"id":"nce2-001","book":"nce2","numbers":[1],"label":"Lesson 1","titleEn":"A Private Conversation","titleCn":"私人谈话","audio":"media/lessons/nce2/001.mp3","lines":[{"t":9.77,"en":"Why did the writer complain to the people behind him?","cn":"为什么作者会向他身后的人抱怨呢？"},{"t":15.91,"en":"Last week I went to the theatre.","cn":"上周我去看了电影。"},{"t":19.39,"en":"I had a very good seat.","cn":"我的座位非常好。"},{"t":22.07,"en":"The play was very interesting.","cn":"这出戏非常有趣。"},{"t":25.1,"en":"I did not enjoy it.","cn":"我并不喜欢它。"},{"t":27.43,"en":"A young man and a young woman were sitting behind me.","cn":"一个年轻男子和一个年轻女子坐在我后面。"},{"t":31.96,"en":"They were talking loudly.","cn":"他们说话的声音很大。"},{"t":34.59,"en":"I got very angry.","cn":"我非常生气。"},{"t":37.41,"en":"I could not hear the actors.","cn":"我听不到演员们的声音。"},{"t":40.64,"en":"I turned round.","cn":"我转过身来。"},{"t":42.8,"en":"I looked at the man and the woman angrily.","cn":"我愤怒地瞪着那个男人和那个女人。"},{"t":47.27,"en":"They did not pay any attention.","cn":"他们根本没有理会。"},{"t":50.69,"en":"In the end, I could not bear it.","cn":"最后，我实在无法忍受下去了。"},{"t":54.98,"en":"I turned round again.","cn":"我又转过身去。"},{"t":57.75,"en":"'I can't hear a word!' I said angrily.","cn":"“我一个字都听不见！”我愤怒地说道。"},{"t":63.45,"en":"'It's none of your business,'","cn":"“这不关你的事。”"},{"t":66.27,"en":"the young man said rudely.","cn":"那个年轻人粗鲁地说道。"},{"t":69.0,"en":"'This is a private conversation!'","cn":"“这可是私人谈话！”"}],"words":[{"word":"private","phonetic":["'praivit"],"pos":"a.","meaning":"私人的","us":"media/words/nce2/w0001_a.mp3","uk":"media/words/nce2/w0001_e.mp3"},{"word":"conversation","phonetic":["kɔnvə'seiʃən"],"pos":"n.","meaning":"谈话","us":"media/words/nce2/w0002_a.mp3","uk":"media/words/nce2/w0002_e.mp3"},{"word":"theatre","phonetic":["'θiətə"],"pos":"n.","meaning":"剧场，戏院","us":"media/words/nce2/w0003_a.mp3","uk":"media/words/nce2/w0003_e.mp3"},{"word":"seat","phonetic":["si:t"],"pos":"n.","meaning":"座位","us":"media/words/nce2/w0004_a.mp3","uk":"media/words/nce2/w0004_e.mp3"},{"word":"play","phonetic":["plei"],"pos":"n.","meaning":"戏","us":"media/words/nce2/w0005_a.mp3","uk":"media/words/nce2/w0005_e.mp3"},{"word":"loudly","phonetic":["'laudli"],"pos":"ad.","meaning":"大声地","us":"media/words/nce2/w0006_a.mp3","uk":"media/words/nce2/w0006_e.mp3"},{"word":"angry","phonetic":["'æŋgri"],"pos":"a.","meaning":"生气的","us":"media/words/nce2/w0007_a.mp3","uk":"media/words/nce2/w0007_e.mp3"},{"word":"angrily","phonetic":["'æŋgrili"],"pos":"ad.","meaning":"生气地","us":"media/words/nce2/w0008_a.mp3","uk":"media/words/nce2/w0008_e.mp3"},{"word":"attention","phonetic":["ə'tenʃən"],"pos":"n.","meaning":"注意","us":"media/words/nce2/w0009_a.mp3","uk":"media/words/nce2/w0009_e.mp3"},{"word":"bear","phonetic":["beə"],"pos":"v.","meaning":"容忍","us":"media/words/nce2/w0010_a.mp3","uk":"media/words/nce2/w0010_e.mp3"},{"word":"business","phonetic":["'biznis"],"pos":"n.","meaning":"事","us":"media/words/nce2/w0011_a.mp3","uk":"media/words/nce2/w0011_e.mp3"},{"word":"rudely","phonetic":["'ru:dli"],"pos":"ad.","meaning":"无礼地，粗鲁地","us":"media/words/nce2/w0012_a.mp3","uk":null}]}