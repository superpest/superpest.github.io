{"id":"nce1-097","book":"nce1","numbers":[97,98],"label":"Lesson 97–98","titleEn":"A Small Blue Case","titleCn":"一只蓝色的小箱子","audio":"media/lessons/nce1/097.mp3","lines":[{"t":2.83,"en":"A small blue case","cn":"一个蓝色的小盒子。"},{"t":7.03,"en":"Listen to the tape then answer this question.","cn":"先听这段录音，然后再回答这个问题。"},{"t":12.79,"en":"Does Mr. Hall get his case back?","cn":"霍尔先生能拿回他的案子吗？"},{"t":18.4,"en":"I left a suitcase on the train to London the other day.","cn":"前几天，我把一个行李箱忘在了开往伦敦的火车上。"},{"t":24.39,"en":"Can you describe it, sir?","cn":"先生，您能描述一下它吗？"},{"t":27.81,"en":"It's a small blue case and it's got a zip.","cn":"这是一个蓝色的小盒子，上面有一个拉链。"},{"t":34.27,"en":"There's a label on the handle with my name and address on it.","cn":"把手上有一个标签，上面写着我的名字和地址。"},{"t":40.41,"en":"Is this case yours?","cn":"这是你的箱子吗？"},{"t":43.14,"en":"No, that's not mine.","cn":"不，那不是我的。"},{"t":45.83,"en":"What about this one?","cn":"这个怎么样？"},{"t":48.25,"en":"This one's got a label.","cn":"这个东西有一个标签。"},{"t":51.51,"en":"Let me see it.","cn":"让我看看。"},{"t":53.98,"en":"What's your name and address?","cn":"你叫什么名字，住在哪里？"},{"t":57.5,"en":"David Hall, 83, Bridge Street.","cn":"大卫·霍尔，83岁，住在桥街。"},{"t":62.64,"en":"That's right.","cn":"没错。"},{"t":64.14,"en":"D. N. Hall, 83, Bridge Street.","cn":"D·N·霍尔，83岁，住在桥街。"},{"t":69.99,"en":"Three pounds fifty pence, please.","cn":"请给我三磅五十便士。"},{"t":73.69,"en":"Here you are.","cn":"给你。"},{"t":75.52,"en":"Thank you.","cn":"谢谢。"},{"t":76.89,"en":"Hey!","cn":"嘿！"},{"t":78.11,"en":"What's the matter?","cn":"怎么了？"},{"t":80.09,"en":"This case doesn't belong to me!","cn":"这个箱子不是我的！"},{"t":84.56,"en":"You've given me the wrong case!","cn":"你给我拿错箱子了！"}],"words":[{"word":"leave","phonetic":["li:v"],"pos":"v.","meaning":"遗留","us":"media/words/nce1/w0607_a.mp3","uk":"media/words/nce1/w0607_e.mp3"},{"word":"describe","phonetic":["di'skraib"],"pos":"v.","meaning":"描述","us":"media/words/nce1/w0661_a.mp3","uk":"media/words/nce1/w0661_e.mp3"},{"word":"zip","phonetic":["zip"],"pos":"n.","meaning":"拉链","us":"media/words/nce1/w0662_a.mp3","uk":"media/words/nce1/w0662_e.mp3"},{"word":"label","phonetic":["'leibəl"],"pos":"n.","meaning":"标签","us":"media/words/nce1/w0663_a.mp3","uk":"media/words/nce1/w0663_e.mp3"},{"word":"handle","phonetic":["'hændl"],"pos":"n.","meaning":"提手，把手","us":"media/words/nce1/w0664_a.mp3","uk":"media/words/nce1/w0664_e.mp3"},{"word":"address","phonetic":["ə'dres"],"pos":"n.","meaning":"地址","us":"media/words/nce1/w0665_a.mp3","uk":"media/words/nce1/w0665_e.mp3"},{"word":"pence","phonetic":["pens"],"pos":"n.","meaning":"penny的复数形式","us":"media/words/nce1/w0666_a.mp3","uk":"media/words/nce1/w0666_e.mp3"},{"word":"belong","phonetic":["bi'lɔŋ"],"pos":"v.","meaning":"属于","us":"media/words/nce1/w0667_a.mp3","uk":"media/words/nce1/w0667_e.mp3"}]}