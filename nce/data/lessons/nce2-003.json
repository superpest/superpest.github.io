{"id":"nce2-003","book":"nce2","numbers":[3],"label":"Lesson 3","titleEn":"Please Send Me a Card","titleCn":"请给我寄一张明信片","audio":"media/lessons/nce2/003.mp3","lines":[{"t":11.05,"en":"How many cards did the writer send?","cn":"作家寄出了多少张卡片？"},{"t":16.17,"en":"Postcards always spoil my holidays.","cn":"明信片总是破坏我的假期心情。"},{"t":21.01,"en":"Last summer, I went to Italy.","cn":"去年夏天，我去了意大利。"},{"t":24.26,"en":"I visited museums and sat in public gardens.","cn":"我参观了博物馆，还坐在公共花园里休息。"},{"t":28.95,"en":"A friendly waiter taught me a few words of Italian.","cn":"一位友好的服务员教了我一些意大利语单词；"},{"t":33.45,"en":"Then he lent me a book.","cn":"之后他还借给我一本书。"},{"t":36.1,"en":"I read a few lines, but I did not understand a word.","cn":"我读了几行，但一个字也看不懂。"},{"t":41.78,"en":"Everyday I thought about postcards.","cn":"每天我都在想着那些明信片……"},{"t":46.08,"en":"My holidays passed quickly,","cn":"假期很快就过去了，"},{"t":48.84,"en":"but I did not send cards to my friends.","cn":"但我却没有给朋友们寄任何卡片。"},{"t":52.98,"en":"On the last day I made a big decision.","cn":"在最后一天，我做出了一个重要的决定："},{"t":57.49,"en":"I got up early and bought thirty-seven cards.","cn":"我早早起床，买了三十七张明信片。"},{"t":63.08,"en":"I spent the whole day in my room,","cn":"我一整天都待在房间里，"},{"t":66.55,"en":"but I did not write a single card!","cn":"却一张卡片都没写！"}],"words":[{"word":"send","phonetic":["send"],"pos":"v.","meaning":"寄，送","us":"media/words/nce2/w0018_a.mp3","uk":"media/words/nce2/w0018_e.mp3"},{"word":"postcard","phonetic":["'pəustkɑ:d"],"pos":"n.","meaning":"明信片","us":"media/words/nce2/w0019_a.mp3","uk":"media/words/nce2/w0019_e.mp3"},{"word":"spoil","phonetic":["spɔil"],"pos":"v.","meaning":"使索然无味，损坏","us":"media/words/nce2/w0020_a.mp3","uk":"media/words/nce2/w0020_e.mp3"},{"word":"museum","phonetic":["mju:'ziəm"],"pos":"n.","meaning":"博物馆","us":"media/words/nce2/w0021_a.mp3","uk":"media/words/nce2/w0021_e.mp3"},{"word":"public","phonetic":["'pʌblik"],"pos":"a.","meaning":"公共的","us":"media/words/nce2/w0022_a.mp3","uk":"media/words/nce2/w0022_e.mp3"},{"word":"friendly","phonetic":["'frendli"],"pos":"a.","meaning":"友好的","us":"media/words/nce2/w0023_a.mp3","uk":"media/words/nce2/w0023_e.mp3"},{"word":"waiter","phonetic":["'weitə"],"pos":"n.","meaning":"服务员，招待员","us":"media/words/nce2/w0024_a.mp3","uk":"media/words/nce2/w0024_e.mp3"},{"word":"lend","phonetic":["lend"],"pos":"v.","meaning":"借给","us":"media/words/nce2/w0025_a.mp3","uk":"media/words/nce2/w0025_e.mp3"},{"word":"decision","phonetic":["di'siʒən"],"pos":"n.","meaning":"决定","us":"media/words/nce2/w0026_a.mp3","uk":"media/words/nce2/w0026_e.mp3"},{"word":"whole","phonetic":["həul"],"pos":"a.","meaning":"整个的","us":"media/words/nce2/w0027_a.mp3","uk":"media/words/nce2/w0027_e.mp3"},{"word":"single","phonetic":["'siŋgəl"],"pos":"a.","meaning":"唯一的，单一的","us":"media/words/nce2/w0028_a.mp3","uk":"media/words/nce2/w0028_e.mp3"}]}