{"id":"nce1-085","book":"nce1","numbers":[85,86],"label":"Lesson 85–86","titleEn":"\"Paris in the Spring.\"","titleCn":"巴黎之春","audio":"media/lessons/nce1/085.mp3","lines":[{"t":2.94,"en":"'Paris in the Spring'.","cn":"《春天的巴黎》。"},{"t":6.34,"en":"Listen to the tape then answer this question.","cn":"先听这段录音，然后再回答这个问题。"},{"t":11.75,"en":"At what time of year did Ken visit Paris?","cn":"肯是在一年中的什么时候去巴黎的？"},{"t":18.63,"en":"Hello, Ken.","cn":"你好，肯。"},{"t":20.18,"en":"Hi, George.","cn":"嗨，乔治。"},{"t":22.2,"en":"Have you just been to the cinema?","cn":"你刚从电影院出来吗？"},{"t":25.21,"en":"Yes, I have.","cn":"是的，我有。"},{"t":27.51,"en":"What's on?","cn":"发生了什么事？"},{"t":29.14,"en":"'Paris in the Spring'.","cn":"《春天的巴黎》。"},{"t":31.66,"en":"Oh, I've already seen it.","cn":"哦，我已经看过了。"},{"t":34.87,"en":"I saw it on television last year.","cn":"我去年在电视上看到过它。"},{"t":38.84,"en":"It's an old film, but it's very good.","cn":"这是一部老电影，不过非常精彩。"},{"t":43.43,"en":"Paris is a beautiful city.","cn":"巴黎是一座美丽的城市。"},{"t":46.81,"en":"I've never been there.","cn":"我从未去过那里。"},{"t":48.97,"en":"Have you ever been there, Ken?","cn":"你曾经去过那里吗，肯？"},{"t":52.0,"en":"Yes, I have.","cn":"是的，我有。"},{"t":53.95,"en":"I was there in April.","cn":"我四月份去过那里。"},{"t":57.35,"en":"Paris in the spring, eh?","cn":"春天的巴黎，对吧？"},{"t":60.46,"en":"It was spring, but the weather was awful.","cn":"虽然是春天，但天气却糟透了。"},{"t":64.68,"en":"It rained all the time.","cn":"雨一直下个不停。"},{"t":67.89,"en":"Just like London!","cn":"就像伦敦一样！"}],"words":[{"word":"Paris","phonetic":["'pæris"],"pos":"n.","meaning":"巴黎","us":"media/words/nce1/w0609_a.mp3","uk":"media/words/nce1/w0609_e.mp3"},{"word":"cinema","phonetic":["'sinimə"],"pos":"n.","meaning":"电影院","us":"media/words/nce1/w0610_a.mp3","uk":"media/words/nce1/w0610_e.mp3"},{"word":"film","phonetic":["film"],"pos":"n.","meaning":"电影","us":"media/words/nce1/w0611_a.mp3","uk":"media/words/nce1/w0611_e.mp3"},{"word":"beautiful","phonetic":["'bju:tifəl"],"pos":"a.","meaning":"漂亮的","us":"media/words/nce1/w0612_a.mp3","uk":"media/words/nce1/w0612_e.mp3"},{"word":"city","phonetic":["'siti"],"pos":"n.","meaning":"城市","us":"media/words/nce1/w0613_a.mp3","uk":"media/words/nce1/w0613_e.mp3"},{"word":"never","phonetic":["'nevə"],"pos":"ad.","meaning":"从来没有","us":"media/words/nce1/w0614_a.mp3","uk":"media/words/nce1/w0614_e.mp3"},{"word":"ever","phonetic":["'evə"],"pos":"ad.","meaning":"在任何时候","us":"media/words/nce1/w0615_a.mp3","uk":"media/words/nce1/w0615_e.mp3"}]}