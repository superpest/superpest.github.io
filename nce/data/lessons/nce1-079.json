{"id":"nce1-079","book":"nce1","numbers":[79,80],"label":"Lesson 79–80","titleEn":"Carol's Shopping List","titleCn":"卡罗尔的购物单","audio":"media/lessons/nce1/079.mp3","lines":[{"t":3.52,"en":"Carol's shopping list","cn":"卡罗尔的购物清单"},{"t":6.72,"en":"Listen to the tape then answer this question.","cn":"请听录音，然后回答这个问题："},{"t":12.24,"en":"What is Carol not going to buy?","cn":"卡罗尔不会买什么？"},{"t":17.91,"en":"What are you doing, Carol?","cn":"你在做什么，卡罗尔？"},{"t":21.73,"en":"I'm making a shopping list, Tom.","cn":"我在列购物清单呢，汤姆。"},{"t":26.48,"en":"What do we need?","cn":"我们需要些什么？"},{"t":29.57,"en":"We need a lot of things this week.","cn":"这周我们需要很多东西。"},{"t":33.62,"en":"I must go to the grocer's.","cn":"我必须去杂货店。"},{"t":37.25,"en":"We haven't got much tea or coffee, and we haven't got any sugar or jam.","cn":"我们的茶和咖啡都不多了，糖和果酱也用完了。"},{"t":46.59,"en":"What about vegetables?","cn":"蔬菜呢？"},{"t":49.38,"en":"I must go to the greengroce's.","cn":"我必须去蔬菜店。"},{"t":53.55,"en":"We haven't got many tomatoes, but we've got a lot of potatoes.","cn":"我们的番茄不多，但是土豆有很多。"},{"t":61.5,"en":"I must go to the butcher's, too.","cn":"我也必须去肉店一趟。"},{"t":65.45,"en":"We need some meat.","cn":"我们需要一些肉。"},{"t":68.23,"en":"We haven't got any meat at all.","cn":"我们根本没有任何肉了。"},{"t":73.34,"en":"Have we got any beer and wine?","cn":"我们还有啤酒和葡萄酒吗？"},{"t":77.3,"en":"No, we haven't.","cn":"不，我们还没有。"},{"t":79.77,"en":"And I'm not going to get any!","cn":"而我一分钱也拿不到！"},{"t":83.54,"en":"I hope that you've got some money.","cn":"我希望你有些钱。"},{"t":87.03,"en":"I haven't got much.","cn":"我没什么东西了。"},{"t":89.55,"en":"Well, I haven't got much either!","cn":"嗯，我也没什么太多东西了！"}],"words":[{"word":"shopping","phonetic":["'ʃɔpiŋ"],"pos":"n.","meaning":"购物","us":"media/words/nce1/w0582_a.mp3","uk":"media/words/nce1/w0582_e.mp3"},{"word":"list","phonetic":["list"],"pos":"n.","meaning":"单子","us":"media/words/nce1/w0583_a.mp3","uk":"media/words/nce1/w0583_e.mp3"},{"word":"vegetable","phonetic":["'vedʒtəbəl"],"pos":"n.","meaning":"蔬菜","us":"media/words/nce1/w0584_a.mp3","uk":"media/words/nce1/w0584_e.mp3"},{"word":"need","phonetic":["ni:d"],"pos":"v.","meaning":"需要","us":"media/words/nce1/w0585_a.mp3","uk":"media/words/nce1/w0585_e.mp3"},{"word":"hope","phonetic":["həup"],"pos":"v.","meaning":"希望","us":"media/words/nce1/w0586_a.mp3","uk":"media/words/nce1/w0586_e.mp3"},{"word":"thing","phonetic":["θiŋ"],"pos":"n.","meaning":"事情","us":"media/words/nce1/w0587_a.mp3","uk":"media/words/nce1/w0587_e.mp3"},{"word":"money","phonetic":["'mʌni"],"pos":"n.","meaning":"钱","us":"media/words/nce1/w0588_a.mp3","uk":"media/words/nce1/w0588_e.mp3"},{"word":"groceries","phonetic":["'grəusəriz"],"pos":"n.","meaning":"食品杂货","us":"media/words/nce1/w0589_a.mp3","uk":"media/words/nce1/w0589_e.mp3"},{"word":"fruit","phonetic":["fru:t"],"pos":"n.","meaning":"水果","us":"media/words/nce1/w0590_a.mp3","uk":"media/words/nce1/w0590_e.mp3"},{"word":"stationery","phonetic":["'steiʃənəri","-neri"],"pos":"n.","meaning":"文具","us":"media/words/nce1/w0591_a.mp3","uk":"media/words/nce1/w0591_e.mp3"},{"word":"newsagent","phonetic":["'nju:zˌeidʒənt"],"pos":"n.","meaning":"报刊零售人","us":"media/words/nce1/w0592_a.mp3","uk":"media/words/nce1/w0592_e.mp3"},{"word":"chemist","phonetic":["'kemist"],"pos":"n.","meaning":"化剂师，化学家","us":"media/words/nce1/w0593_a.mp3","uk":"media/words/nce1/w0593_e.mp3"}]}