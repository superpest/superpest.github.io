{"id":"nce1-059","book":"nce1","numbers":[59,60],"label":"Lesson 59–60","titleEn":"Is That All?","titleCn":"就这些吗？","audio":"media/lessons/nce1/059.mp3","lines":[{"t":3.2,"en":"Is that all?","cn":"就这些吗？"},{"t":6.18,"en":"Listen to the tape then answer this question.","cn":"先听这段录音，然后再回答这个问题。"},{"t":11.77,"en":"Does the lady buy any chalk?","cn":"那位女士会买粉笔吗？"},{"t":16.33,"en":"I want some envelopes, please.","cn":"请给我一些信封。"},{"t":20.25,"en":"Do you want the large size or the small size?","cn":"您想要大号的还是小号的？"},{"t":25.21,"en":"The large size, please.","cn":"请给我大号的。"},{"t":28.55,"en":"Do you have any writing paper?","cn":"你们有写字用的纸吗？"},{"t":31.84,"en":"Yes, we do.","cn":"是的，我们确实会这样做。"},{"t":34.41,"en":"I don't have any small pads.","cn":"我没有任何小垫子。"},{"t":38.34,"en":"I only have large ones.","cn":"我只有大号的（东西）。"},{"t":41.66,"en":"Do you want a pad?","cn":"你需要一个垫子吗？"},{"t":44.17,"en":"Yes, please.","cn":"好的，请告诉我您需要翻译的内容吧。"},{"t":46.44,"en":"And I want some glue.","cn":"我还需要一些胶水。"},{"t":49.87,"en":"A bottle of glue.","cn":"一瓶胶水。"},{"t":53.06,"en":"And I want a large box of chalk, too.","cn":"我还需要一盒大号的粉笔。"},{"t":58.21,"en":"I only have small boxes.","cn":"我只有小盒子而已。"},{"t":61.46,"en":"Do you want one?","cn":"你想要一个吗？"},{"t":63.08,"en":"No, thank you.","cn":"不，谢谢。"},{"t":64.94,"en":"Is that all?","cn":"就这些吗？"},{"t":66.57,"en":"That's all, thank you.","cn":"就这些，谢谢。"},{"t":69.29,"en":"What else do you want?","cn":"你还想要什么？"},{"t":71.55,"en":"I want my change.","cn":"我想要我的零钱。"}],"words":[{"word":"envelope","phonetic":["'envələup"],"pos":"n.","meaning":"信封","us":"media/words/nce1/w0465_a.mp3","uk":"media/words/nce1/w0465_e.mp3"},{"word":"writing paper","phonetic":[],"pos":"","meaning":"信纸","us":null,"uk":"media/words/nce1/w0466_e.mp3"},{"word":"shop assistant","phonetic":[],"pos":"","meaning":"售货员","us":null,"uk":null},{"word":"size","phonetic":["saiz"],"pos":"n.","meaning":"尺寸，尺码，大小","us":"media/words/nce1/w0468_a.mp3","uk":"media/words/nce1/w0468_e.mp3"},{"word":"pad","phonetic":["pæd"