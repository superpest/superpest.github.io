{"id":"nce1-025","book":"nce1","numbers":[25,26],"label":"Lesson 25–26","titleEn":"Mrs. Smith's Kitchen","titleCn":"史密斯夫人的厨房","audio":"media/lessons/nce1/025.mp3","lines":[{"t":3.18,"en":"Mrs. Smith's Kitchen","cn":"史密斯夫人的厨房"},{"t":6.61,"en":"Listen to the tape then answer this question.","cn":"先听这段录音，然后再回答这个问题。"},{"t":12.58,"en":"What colour is the electric cooker?","cn":"这个电饭煲是什么颜色的？"},{"t":18.31,"en":"Mrs. Smith's kitchen is small.","cn":"史密斯太太的厨房很小。"},{"t":23.12,"en":"There is a refrigerator in the kitchen.","cn":"厨房里有一台冰箱。"},{"t":27.71,"en":"The refrigerator is white.","cn":"冰箱是白色的。"},{"t":31.62,"en":"It is on the right.","cn":"它在右边。"},{"t":35.03,"en":"There is an electric cooker in the kitchen.","cn":"厨房里有一台电炉。"},{"t":39.62,"en":"The cooker is blue.","cn":"这个炊具是蓝色的。"},{"t":42.95,"en":"It is on the left.","cn":"它在左边。"},{"t":46.22,"en":"There is a table in the middle of the room.","cn":"房间中央有一张桌子。"},{"t":51.54,"en":"There is a bottle on the table.","cn":"桌子上有一个瓶子。"},{"t":55.27,"en":"The bottle is empty.","cn":"这个瓶子是空的。"},{"t":59.1,"en":"There is a cup on the table, too.","cn":"桌子上还有一个杯子。"},{"t":63.83,"en":"The cup is clean.","cn":"这个杯子是干净的。"}],"words":[{"word":"Mrs.","phonetic":["'misiz"],"pos":"","meaning":"夫人","us":"media/words/nce1/w0202_a.mp3","uk":"media/words/nce1/w0202_e.mp3"},{"word":"kitchen","phonetic":["'kitʃin"],"pos":"n.","meaning":"厨房","us":"media/words/nce1/w0203_a.mp3","uk":"media/words/nce1/w0203_e.mp3"},{"word":"refrigerator","phonetic":["ri'fridʒəreitə"],"pos":"n.","meaning":"电冰箱","us":"media/words/nce1/w0204_a.mp3","uk":"media/words/nce1/w0204_e.mp3"},{"word":"right","phonetic":["rait"],"pos":"n.","meaning":"右边","us":"media/words/nce1/w0160_a.mp3","uk":"media/words/nce1/w0160_e.mp3"},{"word":"electric","phonetic":["i'lektrik"],"pos":"a.","meaning":"带电的，可通电的","us":"media/words/nce1/w0205_a.mp3","uk":"media/words/nce1/w0205_e.mp3"},{"word":"left","phonetic":["left"],"pos":"n.","meaning":"左边","us":"media/words/nce1/w0206_a.mp3","uk":"media/words