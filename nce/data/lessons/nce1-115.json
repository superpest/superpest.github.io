{"id":"nce1-115","book":"nce1","numbers":[115,116],"label":"Lesson 115–116","titleEn":"Knock, Knock!","titleCn":"敲敲门！","audio":"media/lessons/nce1/115.mp3","lines":[{"t":4.23,"en":"Knock, knock!","cn":"咚咚！"},{"t":6.96,"en":"Listen to the tape then answer this question.","cn":"先听这段录音，然后回答这个问题："},{"t":12.74,"en":"What does Jim have to drink?","cn":"吉姆要喝什么？"},{"t":18.07,"en":"Isn't there anyone at home?","cn":"家里没人吗？"},{"t":21.56,"en":"I'll knock again, Helen.","cn":"我再敲一次门，海伦。"},{"t":24.61,"en":"Everything's very quiet.","cn":"家里一片寂静……"},{"t":27.6,"en":"I'm sure there's no one at home.","cn":"我确定家里没人……"},{"t":30.9,"en":"But that's impossible.","cn":"但那不可能啊……"},{"t":33.61,"en":"Carol and Tom invited us to lunch.","cn":"卡罗尔和汤姆邀请我们吃午饭了……"},{"t":37.8,"en":"Look through the window.","cn":"透过窗户看看吧……"},{"t":40.7,"en":"Can you see anything?","cn":"你能看到什么吗？"},{"t":43.71,"en":"Nothing at all.","cn":"什么也没有。"},{"t":45.78,"en":"Let's try the back door.","cn":"我们试试别的办法吧。"},{"t":49.22,"en":"Look! Everyone's in the garden.","cn":"看！大家都在花园里。"},{"t":53.22,"en":"Hello, Helen. Hello, Jim.","cn":"你好，海伦。你好，吉姆。"},{"t":57.31,"en":"Everybody wants to have lunch in the garden.","cn":"大家都想在花园里吃午饭。"},{"t":61.36,"en":"It's nice and warm out here.","cn":"外面天气很暖和，很舒服。"},{"t":64.91,"en":"Come and have something to drink.","cn":"过来喝点东西吧。"},{"t":68.73,"en":"Thanks, Carol.","cn":"谢谢，卡罗尔。"},{"t":70.77,"en":"May I have a glass of beer please?","cn":"可以给我一杯啤酒吗？"},{"t":74.58,"en":"Beer?","cn":"啤酒？"},{"t":75.72,"en":"There's none left.","cn":"没有了。"},{"t":77.87,"en":"You can have some lemonade.","cn":"你可以喝点柠檬水。"},{"t":81.04,"en":"Lemonade!","cn":"柠檬水！"},{"t":82.67,"en":"Don't believe her, Jim.","cn":"别相信她，吉姆。"},{"t":84.71,"en":"She's only joking.","cn":"她只是在开玩笑而已。"},{"t":86.59,"en":"Have some beer!","cn":"来喝点啤酒吧！"}],"words":[{"word":"anyone","phonetic":["'eniwʌn"],"pos":"pron.","meaning":"(用于疑问句，否定式)任何人","us":"media/words/nce1/w0748_a.mp3","uk":"media/words/nce1/w0748_e.mp3"},{"word":"knock","phonetic":["nɔk"],"pos":"v.","meaning":"敲，打","us":"media/words/nce1/w0749_a.mp3","uk":"media/words/nce1/w0749_e.mp3"},{"word":"everything","phonetic":["'evriθiŋ"],"pos":"pron.","meaning":"一切事物","us":"media/words/nce1/w0750_a.mp3","uk":"media/words/nce1/w0750_e.mp3"},{"word":"quiet","phonetic":["'kwaiət"],"pos":"a.","meaning":"宁静的，安静的","us":"media/words/nce1/w0751_a.mp3","uk":"media/words/nce1/w0751_e.mp3"},{"word":"impossible","phonetic":["im'pɔsəbəl"],"pos":"a.","meaning":"不可能的","us":"media/words/nce1/w0752_a.mp3","uk":"media/words/nce1/w0752_e.mp3"},{"word":"invite","phonetic":["in'vait"],"pos":"v.","meaning":"邀请","us":"media/words/nce1/w0753_a.mp3","uk":"media/words/nce1/w0753_e.mp3"},{"word":"anything","phonetic":["'eniθiŋ"],"pos":"pron.","meaning":"任何东西","us":"media/words/nce1/w0754_a.mp3","uk":"media/words/nce1/w0754_e.mp3"},{"word":"nothing","phonetic":["'nʌθiŋ"],"pos":"pron.","meaning":"什么也没有","us":"media/words/nce1/w0755_a.mp3","uk":"media/words/nce1/w0755_e.mp3"},{"word":"lemonade","phonetic":["ˌlemə'neid"],"pos":"n.","meaning":"柠檬水","us":"media/words/nce1/w0756_a.mp3","uk":"media/words/nce1/w0756_e.mp3"},{"word":"joke","phonetic":["dʒəuk"],"pos":"v.","meaning":"开玩笑","us":"media/words/nce1/w0757_a.mp3","uk":"media/words/nce1/w0757_e.mp3"},{"word":"asleep","phonetic":["ə'sli:p"],"pos":"a.","meaning":"睡觉，睡着(用作表语)","us":"media/words/nce1/w0758_a.mp3","uk":"media/words/nce1/w0758_e.mp3"},{"word":"glasses","phonetic":["'gla:siz"],"pos":"n.","meaning":"眼镜","us":"media/words/nce1/w0759_a.mp3","uk":"media/words/nce1/w0759_e.mp3"}]}