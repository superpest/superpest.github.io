{"id":"nce1-031","book":"nce1","numbers":[31,32],"label":"Lesson 31–32","titleEn":"Where's Sally?","titleCn":"莎莉在哪里？","audio":"media/lessons/nce1/031.mp3","lines":[{"t":3.04,"en":"Where's Sally?","cn":"莎莉在哪里？"},{"t":5.65,"en":"Listen to the tape then answer this question.","cn":"先听这段录音，然后回答这个问题。"},{"t":11.45,"en":"Is the cat climbing the tree?","cn":"那只猫在爬树吗？"},{"t":15.84,"en":"Where's Sally, Jack?","cn":"莎莉在哪里，杰克？"},{"t":18.67,"en":"She's in the garden, Jean.","cn":"她在花园里，琼。"},{"t":21.45,"en":"What's she doing?","cn":"她在做什么？"},{"t":23.47,"en":"She's sitting under the tree.","cn":"她正坐在树下。"},{"t":26.56,"en":"Is Tim in the garden, too?","cn":"蒂姆也在花园里吗？"},{"t":29.88,"en":"Yes, he is.","cn":"是的，他在。"},{"t":31.82,"en":"He's climbing the tree.","cn":"他正在爬树。"},{"t":34.68,"en":"I beg your pardon?","cn":"你说什么？"},{"t":36.91,"en":"Who's climbing the tree?","cn":"谁在爬树？"},{"t":39.47,"en":"Tim is.","cn":"是蒂姆。"},{"t":41.41,"en":"What about the dog?","cn":"那狗呢？"},{"t":44.25,"en":"The dog's in the garden, too.","cn":"狗也在花园里。"},{"t":46.89,"en":"It's running across the grass.","cn":"它正在草地上跑来跑去。"},{"t":50.02,"en":"It's running after a cat.","cn":"它正在追一只猫。"}],"words":[{"word":"garden","phonetic":["'gɑ:dn"],"pos":"n.","meaning":"花园","us":"media/words/nce1/w0236_a.mp3","uk":"media/words/nce1/w0236_e.mp3"},{"word":"under","phonetic":["'ʌndə"],"pos":"prep.","meaning":"在…之下","us":"media/words/nce1/w0237_a.mp3","uk":"media/words/nce1/w0237_e.mp3"},{"word":"tree","phonetic":["tri:"],"pos":"n.","meaning":"树","us":"media/words/nce1/w0238_a.mp3","uk":"media/words/nce1/w0238_e.mp3"},{"word":"climb","phonetic":["klaim"],"pos":"v.","meaning":"爬，攀登","us":"media/words/nce1/w0239_a.mp3","uk":"media/words/nce1/w0239_e.mp3"},{"word":"who","phonetic":["hu:"],"pos":"pron.","meaning":"谁","us":"media/words/nce1/w0240_a.mp3","uk":"media/words/nce1/w0240_e.mp3"},{"word":"run","phonetic":["rʌn"],"pos":"v.","meaning":"跑","us":"media/words/nce1/w0241_a.mp3","uk":"media/words/nce1/w0241_e.mp3"},{"word":"grass","pho