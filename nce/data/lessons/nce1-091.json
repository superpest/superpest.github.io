{"id":"nce1-091","book":"nce1","numbers":[91,92],"label":"Lesson 91–92","titleEn":"Poor Ian!","titleCn":"可怜的伊恩","audio":"media/lessons/nce1/091.mp3","lines":[{"t":3.45,"en":"Poor Ian!","cn":"可怜的伊恩！"},{"t":6.26,"en":"Listen to the tape then answer this question.","cn":"先听这段录音，然后再回答这个问题。"},{"t":12.13,"en":"Who wanted to sell the house?","cn":"谁想卖掉这栋房子呢？"},{"t":17.55,"en":"Has Ian sold his house yet?","cn":"伊恩已经卖掉他的房子了吗？"},{"t":21.25,"en":"Yes, he has.","cn":"是的，他确实有。"},{"t":23.21,"en":"He sold it last week.","cn":"他上周把它卖掉了。"},{"t":26.92,"en":"Has he moved to his new house yet?","cn":"他已经搬进新房子了吗？"},{"t":31.45,"en":"No, not yet.","cn":"不，还没有。"},{"t":33.81,"en":"He's still here.","cn":"他还在这里。"},{"t":36.05,"en":"He's going to move tomorrow.","cn":"他明天就要搬家了。"},{"t":39.82,"en":"When? Tomorrow morning?","cn":"什么时候？明天早上吗？"},{"t":44.12,"en":"No. Tomorrow afternoon.","cn":"不，明天下午。"},{"t":47.83,"en":"I'll miss him.","cn":"我会想念他的。"},{"t":49.89,"en":"He has always been a good neighbour.","cn":"他一直是个很好的邻居。"},{"t":54.57,"en":"He's a very nice person.","cn":"他是个非常友善的人。"},{"t":58.17,"en":"We'll all miss him.","cn":"我们都会想念他的。"},{"t":62.21,"en":"When will the new people move into this house?","cn":"新搬来的人什么时候会入住这栋房子呢？"},{"t":67.54,"en":"I think that they'll move in the day after tomorrow.","cn":"我认为他们会在后天搬进来。"},{"t":74.22,"en":"Will you see Ian today, Jenny?","cn":"珍妮，你今天会见到伊恩吗？"},{"t":79.71,"en":"Yes, I will.","cn":"是的，我会这么做的。"},{"t":83.09,"en":"Please give him my regards.","cn":"请代我向他问好。"},{"t":87.83,"en":"Poor Ian! He didn't want to leave this house.","cn":"可怜的伊恩！他根本不想离开这栋房子。"},{"t":94.49,"en":"No, he didn't want to leave, but his wife did!","cn":"不，他并不想离开，但他的妻子却想离开了！"}],"words":[{"word":"still","phonetic":["stil"],"pos":"ad.","meaning":"还，仍旧","us":"media/words/nce1/w0635_a.mp3","uk":"media/words/nce1/w0635_e.mp3"},{"word":"move","phonetic":["mu:v"],"pos":"v.","meaning":"搬家","us":"media/words/nce1/w0636_a.mp3","uk":"media/words/nce1/w0636_e.mp3"},{"word":"miss","phonetic":["mis"],"pos":"v.","meaning":"想念，思念","us":null,"uk":null},{"word":"neighbour","phonetic":["'neibə"],"pos":"n.","meaning":"邻居","us":"media/words/nce1/w0638_a.mp3","uk":"media/words/nce1/w0638_e.mp3"},{"word":"person","phonetic":["'pə:sn"],"pos":"n.","meaning":"人","us":"media/words/nce1/w0639_a.mp3","uk":"media/words/nce1/w0639_e.mp3"},{"word":"people","phonetic":["'pi:pl"],"pos":"n.","meaning":"人们","us":"media/words/nce1/w0640_a.mp3","uk":"media/words/nce1/w0640_e.mp3"},{"word":"poor","phonetic":["puə"],"pos":"a.","meaning":"可怜的","us":"media/words/nce1/w0641_a.mp3","uk":"media/words/nce1/w0641_e.mp3"}]}