{"id":"nce1-045","book":"nce1","numbers":[45,46],"label":"Lesson 45–46","titleEn":"The Boss's Letter","titleCn":"老板的信","audio":"media/lessons/nce1/045.mp3","lines":[{"t":3.02,"en":"The boss's letter","cn":"老板的信"},{"t":6.17,"en":"Listen to the tape then answer this question.","cn":"先听这段录音，然后再回答这个问题。"},{"t":11.91,"en":"Why can't Pamela type the letter?","cn":"为什么帕梅拉打不出这个字母呢？"},{"t":17.66,"en":"Can you come here a minute please, Bob?","cn":"鲍勃，你能过来一下吗？"},{"t":21.77,"en":"Yes, sir?","cn":"是的，先生。"},{"t":24.03,"en":"Where's Pamela?","cn":"帕梅拉在哪里？"},{"t":26.2,"en":"She's next door.","cn":"她住在隔壁。"},{"t":28.24,"en":"She's in her office, sir.","cn":"她现在在她的办公室里，先生。"},{"t":31.48,"en":"Can she type this letter for me?","cn":"她能帮我打这封信吗？"},{"t":35.19,"en":"Ask her please.","cn":"请问她吧。"},{"t":36.92,"en":"Yes, sir.","cn":"是的，先生。"},{"t":39.31,"en":"Can you type this letter for the boss please, Pamela?","cn":"帕梅拉，你能帮老板把这封信打出来吗？"},{"t":44.15,"en":"Yes, of course I can.","cn":"当然可以。"},{"t":47.75,"en":"Here you are.","cn":"给你。"},{"t":49.36,"en":"Thank you, Bob.","cn":"谢谢你，鲍勃。"},{"t":51.88,"en":"Bob!","cn":"鲍勃！"},{"t":52.73,"en":"Yes?","cn":"是的？"},{"t":53.94,"en":"What's the matter?","cn":"怎么了？"},{"t":56.11,"en":"I can't type this letter.","cn":"我无法打出这封信的内容。"},{"t":59.3,"en":"I can't read it!","cn":"我看不懂这个！"},{"t":61.59,"en":"The boss's handwriting is terrible!","cn":"老板的笔迹太糟糕了！"}],"words":[{"word":"can","phonetic":["kæn"],"pos":"","meaning":"能够","us":"media/words/nce1/w0331_a.mp3","uk":"media/words/nce1/w0331_e.mp3"},{"word":"boss","phonetic":["bɔs"],"pos":"n.","meaning":"老板，上司","us":"media/words/nce1/w0332_a.mp3","uk":"media/words/nce1/w0332_e.mp3"},{"word":"minute","phonetic":["'minit"],"pos":"n.","meaning":"分(钟)","us":"media/words/nce1/w0333_a.mp3","uk":"media/words/nce1/w0333_e.mp3"},{"word":"ask","phonetic":["ɑ:sk"],"pos":"v.","meaning":"请求，要求","us":"media/words/nce1/w0334_a.mp3","uk":"media/words/nce1/w0334_e.mp3"},{"word":"handwriting","phonetic":["'hændˌraitiŋ"],"pos":"n.","meani