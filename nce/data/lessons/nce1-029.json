{"id":"nce1-029","book":"nce1","numbers":[29,30],"label":"Lesson 29–30","titleEn":"Come In, Amy.","titleCn":"琼斯夫人的卧室","audio":"media/lessons/nce1/029.mp3","lines":[{"t":3.33,"en":"Come in, Amy.","cn":"进来，艾米。"},{"t":6.85,"en":"Listen to the tape then answer this question.","cn":"先听这段录音，然后再回答这个问题。"},{"t":12.6,"en":"How must Amy clean the floor?","cn":"艾米应该怎样打扫地板呢？"},{"t":17.3,"en":"Come in, Amy.","cn":"进来，艾米。"},{"t":19.85,"en":"Shut the door, please.","cn":"请把门关上。"},{"t":22.49,"en":"This bedroom's very untidy.","cn":"这个卧室非常乱糟糟的。"},{"t":26.83,"en":"What must I do, Mrs. Jones?","cn":"我该怎么办，琼斯太太？"},{"t":30.53,"en":"Open the window and air the room.","cn":"打开窗户让房间通风。"},{"t":34.92,"en":"Then put these clothes in the wardrobe.","cn":"然后把这些衣服放进衣柜里。"},{"t":39.69,"en":"Then make the bed.","cn":"接着整理床铺。"},{"t":42.81,"en":"Dust the dressing table.","cn":"最后擦擦梳妆台上的灰尘。"},{"t":45.85,"en":"Then sweep the floor.","cn":"然后拖地。"}],"words":[{"word":"shut","phonetic":["ʃʌt"],"pos":"v.","meaning":"关门","us":"media/words/nce1/w0165_a.mp3","uk":"media/words/nce1/w0165_e.mp3"},{"word":"bedroom","phonetic":["'bedrum","-ru:m"],"pos":"n.","meaning":"卧室","us":"media/words/nce1/w0221_a.mp3","uk":"media/words/nce1/w0221_e.mp3"},{"word":"untidy","phonetic":["ˌʌn'taidi"],"pos":"a.","meaning":"乱，不整齐","us":"media/words/nce1/w0222_a.mp3","uk":"media/words/nce1/w0222_e.mp3"},{"word":"must","phonetic":["mʌst"],"pos":"modal verb.","meaning":"必须，应该","us":"media/words/nce1/w0223_a.mp3","uk":"media/words/nce1/w0223_e.mp3"},{"word":"open","phonetic":["'əupən"],"pos":"v.","meaning":"打开","us":"media/words/nce1/w0164_a.mp3","uk":"media/words/nce1/w0164_e.mp3"},{"word":"air","phonetic":["eə"],"pos":"v.","meaning":"使…通风，换换空气","us":"media/words/nce1/w0224_a.mp3","uk":"media/words/nce1/w0224_e.mp3"},{"word":"put","phonetic":["put"],"pos":"v.","meaning":"放置","us":"media/words/nce1/w0225_a.mp3","uk":"media/words/nce1/w0225_e.mp3"},{"word":"clothes","phonetic":["kləuðz"],"pos":"n.","meaning":"衣服","us":"media/words/nce1/w