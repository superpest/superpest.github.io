{"id":"nce1-105","book":"nce1","numbers":[105,106],"label":"Lesson 105–106","titleEn":"Full of Mistakes","titleCn":"错误百出","audio":"media/lessons/nce1/105.mp3","lines":[{"t":3.45,"en":"Full of mistakes","cn":"满是错误"},{"t":7.08,"en":"Listen to the tape then answer this question.","cn":"请听录音，然后回答这个问题："},{"t":13.49,"en":"What was Sandra's present?","cn":"桑德拉收到了什么礼物？"},{"t":18.33,"en":"Where's Sandra, Bob?","cn":"鲍勃，桑德拉在哪里？"},{"t":20.63,"en":"I want her.","cn":"我想要见她。"},{"t":23.41,"en":"Do you want to speak to her?","cn":"你想和她说话吗？"},{"t":27.38,"en":"Yes, I do.","cn":"是的，我想。"},{"t":29.62,"en":"I want her to come to my office.","cn":"我希望她能来我的办公室。"},{"t":33.42,"en":"Tell her to come at once.","cn":"告诉她立刻过来。"},{"t":37.22,"en":"Did you want to see me?","cn":"你是想见我吗？"},{"t":40.65,"en":"Ah, yes, Sandra.","cn":"啊，是的，桑德拉。"},{"t":43.71,"en":"How do you spell 'intelligent'?","cn":"“intelligent”怎么拼写？"},{"t":47.26,"en":"Can you tell me?","cn":"你能告诉我吗？"},{"t":49.61,"en":"I-N-T-E-L-L-I-G-E-N-T.","cn":"I-N-T-E-L-L-I-G-E-N-T。"},{"t":60.83,"en":"That's right.","cn":"没错。"},{"t":62.79,"en":"You've typed it with only one 'L'.","cn":"你只用了一个“L”来拼写它。"},{"t":66.75,"en":"This letter's full of mistakes.","cn":"这个拼写里有很多错误。"},{"t":70.65,"en":"I want you to type it again.","cn":"我希望你再拼写一遍。"},{"t":74.89,"en":"Yes, I'll do that.","cn":"好的，我会重新拼写的。"},{"t":77.61,"en":"I'm sorry about that.","cn":"关于刚才的错误，我很抱歉。"},{"t":80.43,"en":"And here's a little present for you.","cn":"这里有一个小礼物给你。"},{"t":83.78,"en":"What is it?","cn":"是什么礼物呢？"},{"t":85.48,"en":"It's a dictionary.","cn":"是一本字典。"},{"t":87.61,"en":"I hope it'll help you.","cn":"希望这能对你有所帮助。"}],"words":[{"word":"spell","phonetic":["spel"],"pos":"v.","meaning":"拼写","us":"media/words/nce1/w0711_a.mp3","uk":"media/words/nce1/w0711_e.mp3"},{"word":"intelligent","phonetic":["in'telidʒənt"],"pos":"a.","meaning":"聪明的，有智慧的","us":"media/words/nce1/w0712_a.mp3","uk":"media/words/nce1/w0712_e.mp3"},{"word":"mistake","phonetic":["mis'teik"],"pos":"n.","meaning":"错误","us":"media/words/nce1/w0713_a.mp3","uk":"media/words/nce1/w0713_e.mp3"},{"word":"present","phonetic":["pri'zent","'prezənt"],"pos":"n.","meaning":"礼物","us":"media/words/nce1/w0714_a.mp3","uk":"media/words/nce1/w0714_e.mp3"},{"word":"dictionary","phonetic":["'dikʃənəri"],"pos":"n.","meaning":"词典","us":"media/words/nce1/w0715_a.mp3","uk":"media/words/nce1/w0715_e.mp3"},{"word":"carry","phonetic":["'kæri"],"pos":"v.","meaning":"携带","us":"media/words/nce1/w0716_a.mp3","uk":"media/words/nce1/w0716_e.mp3"},{"word":"correct","phonetic":["kə'rekt"],"pos":"v.","meaning":"改正，纠正","us":"media/words/nce1/w0717_a.mp3","uk":"media/words/nce1/w0717_e.mp3"}]}