{"id":"nce1-061","book":"nce1","numbers":[61,62],"label":"Lesson 61–62","titleEn":"A Bad Cold","titleCn":"重感冒","audio":"media/lessons/nce1/061.mp3","lines":[{"t":3.06,"en":"A bad cold","cn":"重感冒"},{"t":5.92,"en":"Listen to the tape then answer this question.","cn":"请听录音，然后回答以下问题："},{"t":11.15,"en":"What is good news for Jimmy?","cn":"对吉米来说，有什么好消息？"},{"t":16.55,"en":"Where's Jimmy?","cn":"吉米在哪里？"},{"t":18.36,"en":"He's in bed.","cn":"他在床上。"},{"t":20.69,"en":"What's the matter with him?","cn":"他怎么了？"},{"t":23.14,"en":"He feels ill.","cn":"他感觉不舒服。"},{"t":25.84,"en":"He looks ill.","cn":"他看起来也很不舒服。"},{"t":27.86,"en":"We must call the doctor.","cn":"我们必须叫医生来。"},{"t":31.05,"en":"Yes, we must.","cn":"是的，我们必须这么做。"},{"t":34.12,"en":"Can you remember the doctor's telephone number?","cn":"你能记住医生的电话号码吗？"},{"t":38.75,"en":"Yes. It's 09754.","cn":"是的，号码是 09754。"},{"t":45.78,"en":"Open your mouth, Jimmy.","cn":"张开你的嘴，吉米。"},{"t":48.37,"en":"Show me your tongue. Say, 'Ah'.","cn":"把你的舌头伸出来，然后说“Ah”。"},{"t":53.63,"en":"What's the matter with him, doctor?","cn":"医生，他到底怎么了？"},{"t":57.22,"en":"He has a bad cold, Mr. Williams, so he must stay in bed for a week.","cn":"威廉姆斯先生得了重感冒，因此他必须卧床休息一周。"},{"t":65.81,"en":"That's good news for Jimmy.","cn":"这对吉米来说是个好消息。"},{"t":69.35,"en":"Good news? Why?","cn":"好消息？为什么？"},{"t":72.36,"en":"Because he doesn't like school!","cn":"因为他不喜欢上学！"}],"words":[{"word":"feel","phonetic":["fi:l"],"pos":"v.","meaning":"感觉","us":"media/words/nce1/w0473_a.mp3","uk":"media/words/nce1/w0473_e.mp3"},{"word":"look","phonetic":["luk"],"pos":"v.","meaning":"看(起来)","us":"media/words/nce1/w0474_a.mp3","uk":"media/words/nce1/w0474_e.mp3"},{"word":"must","phonetic":["mʌst"],"pos":"","meaning":"必须","us":"media/words/nce1/w0223_a.mp3","uk":"media/words/nce1/w0223_e.mp3"},{"word":"call","phonetic":["kɔ:l"],"pos":"v.","meaning":"叫，请","us":"media/words/nce1/w0475_a.mp3","uk":"media/words/nce1/w0475_e.mp3"},{"word":"doctor","phonetic":["'dɔktə"],"pos":"n.","meaning":"医生","us":"media/