{"id":"nce1-043","book":"nce1","numbers":[43,44],"label":"Lesson 43–44","titleEn":"Hurry Up!","titleCn":"快点！","audio":"media/lessons/nce1/043.mp3","lines":[{"t":3.16,"en":"Hurry up!","cn":"快点！"},{"t":5.71,"en":"Listen to the tape then answer this question.","cn":"先听一下录音，然后回答这个问题。"},{"t":11.33,"en":"How do you know Sam doesn't make the tea very often?","cn":"你怎么知道山姆不经常泡茶的？"},{"t":18.21,"en":"Can you make the tea, Sam?","cn":"你能泡茶吗，山姆？"},{"t":22.14,"en":"Yes, of course I can, Penny.","cn":"当然可以，佩妮。"},{"t":27.3,"en":"Is there any water in this kettle?","cn":"这个水壶里有水吗？"},{"t":31.01,"en":"Yes, there is.","cn":"有。"},{"t":33.61,"en":"Where's the tea?","cn":"茶在哪里？"},{"t":35.39,"en":"It's over there, behind the teapot.","cn":"在茶壶后面。"},{"t":40.99,"en":"Can you see it?","cn":"你能看到它吗？"},{"t":43.56,"en":"I can see the teapot, but I can't see the tea.","cn":"我能看到茶壶，但看不到茶。"},{"t":49.73,"en":"There it is!","cn":"找到了！"},{"t":51.35,"en":"It's in front of you!","cn":"它就在你面前！"},{"t":53.56,"en":"Ah yes, I can see it now.","cn":"啊，对，我现在看到了。"},{"t":58.79,"en":"Where are the cups?","cn":"杯子在哪里？"},{"t":61.23,"en":"There are some in the cupboard.","cn":"有些在橱柜里。"},{"t":64.1,"en":"Can you find them?","cn":"你能找到它们吗？"},{"t":66.22,"en":"Yes. Here they are.","cn":"可以。它们在这里。"},{"t":69.13,"en":"Hurry up, Sam!","cn":"快点，萨姆！"},{"t":71.01,"en":"The kettle's boiling!","cn":"水壶已经烧开了！"}],"words":[{"word":"of course","phonetic":["əv'kɔ:s"],"pos":"","meaning":"当然","us":"media/words/nce1/w0324_a.mp3","uk":"media/words/nce1/w0324_e.mp3"},{"word":"kettle","phonetic":["'ketl"],"pos":"n.","meaning":"水壶","us":"media/words/nce1/w0325_a.mp3","uk":"media/words/nce1/w0325_e.mp3"},{"word":"behind","phonetic":["bi'haind"],"pos":"prep.","meaning":"在…后面","us":"media/words/nce1/w0326_a.mp3","uk":"media/words/nce1/w0326_e.mp3"},{"word":"teapot","phonetic":["'ti:pɔt"],"pos":"n.","meaning":"茶壶","us":"media/words/nce1/w0327_a.mp3","uk":"media/words/nce1/w0327_e.mp3"},{"word":"now","phonetic":["nau"],"pos":"ad.","meaning":"现在，