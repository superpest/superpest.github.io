{"id":"nce1-017","book":"nce1","numbers":[17,18],"label":"Lesson 17–18","titleEn":"How do you do?","titleCn":"你好！","audio":"media/lessons/nce1/017.mp3","lines":[{"t":2.89,"en":"How do you do?","cn":"你是怎么做到的？"},{"t":6.4,"en":"Listen to the tape then answer this question.","cn":"先听这段录音，然后再回答这个问题。"},{"t":12.62,"en":"What are Michael Baker and Jeremy Short's jobs?","cn":"迈克尔·贝克（Michael Baker）和杰里米·肖特（Jeremy Short）分别从事什么工作？"},{"t":19.59,"en":"Come and meet our employees Mr.Richards.","cn":"请来认识一下我们的员工，理查兹先生。"},{"t":25.19,"en":"Thank you Mr. Jackson.","cn":"谢谢您，杰克逊先生。"},{"t":28.45,"en":"This is Nicola Grey","cn":"这是尼古拉·格雷。"},{"t":31.57,"en":"and this is Claire Taylor.","cn":"这是克莱尔·泰勒。"},{"t":35.3,"en":"How do you do?","cn":"你是怎么做到的？"},{"t":38.4,"en":"Those women are very hard-working.","cn":"那些女性都非常勤奋。"},{"t":43.18,"en":"What are their jobs?","cn":"他们的工作是什么？"},{"t":46.6,"en":"They're keyboard operators.","cn":"他们是键盘操作员。"},{"t":50.9,"en":"This is Michael Baker","cn":"这是迈克尔·贝克。"},{"t":53.85,"en":"and this is Jeremy Short.","cn":"这位是杰里米·肖特。"},{"t":57.42,"en":"How do you do?","cn":"你是怎么做到的？"},{"t":60.67,"en":"They aren't very busy!","cn":"他们现在不是很忙！"},{"t":63.8,"en":"What are their jobs?","cn":"他们的工作是什么？"},{"t":67.95,"en":"They're sales reps.","cn":"他们是销售代表。"},{"t":70.21,"en":"They're very lazy.","cn":"他们非常懒。"},{"t":73.28,"en":"Who is this young man?","cn":"这个年轻人是谁？"},{"t":77.03,"en":"This is Jim.","cn":"这是吉姆。"},{"t":79.42,"en":"He's our office assistant.","cn":"他是我们的办公室助理。"}],"words":[{"word":"employee","phonetic":["im'plɔi-i:"],"pos":"n.","meaning":"雇员","us":"media/words/nce1/w0147_a.mp3","uk":"media/words/nce1/w0147_e.mp3"},{"word":"hard-working","phonetic":["'hɑ:dwə:kiŋ"],"pos":"a.","meaning":"勤奋的","us":"media/words/nce1/w0148_a.mp3","uk":"media/words/nce1/w0148_e.mp3"},{"word":"sales reps","phonetic":[],"pos":"","meaning":"推销员","us":null,"uk":null},{"word":"man","phonetic":["mæn"],"pos":"n.","meaning":"男人","us":"media/words/nce1/w0150_a.mp3","uk":"media/words/nce1/w0150_e.