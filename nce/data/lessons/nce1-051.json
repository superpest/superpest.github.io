{"id":"nce1-051","book":"nce1","numbers":[51,52],"label":"Lesson 51–52","titleEn":"A Pleasant Climate","titleCn":"宜人的气候","audio":"media/lessons/nce1/051.mp3","lines":[{"t":3.13,"en":"A pleasant climate","cn":"宜人的气候"},{"t":6.18,"en":"Listen to the tape then answer this question.","cn":"请听录音，然后回答以下问题："},{"t":11.85,"en":"Does it ever snow in Greece?","cn":"希腊会下雪吗？"},{"t":17.01,"en":"Where do you come from?","cn":"你来自哪里？"},{"t":19.9,"en":"I come from Greece.","cn":"我来自希腊。"},{"t":22.94,"en":"What's the climate like in your country?","cn":"你们国家的气候是怎样的？"},{"t":27.32,"en":"It's very pleasant.","cn":"气候非常宜人。"},{"t":30.37,"en":"What's the weather like in spring?","cn":"春天的天气是怎样的？"},{"t":34.29,"en":"It's often windy in March.","cn":"三月份经常有风。"},{"t":37.79,"en":"It's always warm in April and May, but it rains sometimes.","cn":"四月和五月总是很温暖，但有时会下雨。"},{"t":45.53,"en":"What's it like in summer?","cn":"夏天的天气是怎样的？"},{"t":49.04,"en":"It's always hot in June, July and August.","cn":"六月、七月和八月总是很热。"},{"t":54.7,"en":"The sun shines every day.","cn":"太阳每天都会升起。"},{"t":58.16,"en":"Is it cold or warm in autumn?","cn":"秋天是冷还是暖呢？"},{"t":62.17,"en":"It's always warm in September and October.","cn":"九月份和十月份总是很暖和的。"},{"t":67.11,"en":"It's often cold in November and it rains sometimes.","cn":"十一月份天气通常很冷，有时还会下雨。"},{"t":73.51,"en":"Is it very cold in winter?","cn":"冬天会很冷吗？"},{"t":77.23,"en":"It's often cold in December, January and February.","cn":"十二月、一月和二月通常都很冷。"},{"t":83.34,"en":"It snows sometimes.","cn":"有时候会下雪。"}],"words":[{"word":"Greece","phonetic":["gri:s"],"pos":"n.","meaning":"希腊","us":"media/words/nce1/w0377_a.mp3","uk":"media/words/nce1/w0377_e.mp3"},{"word":"climate","phonetic":["'klaimit"],"pos":"n.","meaning":"气候","us":"media/words/nce1/w0378_a.mp3","uk":"media/words/nce1/w0378_e.mp3"},{"word":"country","phonetic":["'kʌntri"],"pos":"n.","meaning":"国家","us":"media/words/nce1/w0379_a.mp3","uk":"media/words/nce1/w0379_e.mp3"},{"word":"pleasant","phonetic":["'plezənt"],"pos":"a.","meaning":