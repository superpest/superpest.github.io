{"id":"nce1-125","book":"nce1","numbers":[125,126],"label":"Lesson 125–126","titleEn":"Tea for Two","titleCn":"两个人一起喝茶","audio":"media/lessons/nce1/125.mp3","lines":[{"t":3.46,"en":"Tea for two","cn":"“Tea for two” 的意思是“为两个人准备的茶”。"},{"t":6.26,"en":"Listen to the tape then answer this question.","cn":"先听这段录音，然后再回答这个问题。"},{"t":11.22,"en":"Does Susan have tea by herself?","cn":"苏珊有茶喝吗？"},{"t":16.47,"en":"Can't you come in and have tea now, Peter?","cn":"彼得，你现在就不能进来喝杯茶吗？"},{"t":20.97,"en":"Not yet.","cn":"还没有。"},{"t":22.38,"en":"I must water the garden first.","cn":"我必须先给花园浇水。"},{"t":25.78,"en":"Do you have to water it now?","cn":"现在需要给它浇水吗？"},{"t":29.52,"en":"I'm afraid I must.","cn":"恐怕我必须这么做。"},{"t":31.54,"en":"Look at it!","cn":"看啊！"},{"t":33.02,"en":"It's terribly dry.","cn":"天气非常干燥。"},{"t":35.41,"en":"What a nuisance!","cn":"真是个讨厌的家伙（或东西）！"},{"t":38.0,"en":"Last summer it was very dry, too.","cn":"去年夏天也非常干燥。"},{"t":41.98,"en":"Don't you remember?","cn":"你不记得了吗？"},{"t":44.16,"en":"I had to water it every day.","cn":"我每天都必须给它浇水。"},{"t":47.52,"en":"Well, I'll have tea by myself.","cn":"好吧，我就自己喝杯茶吧。"},{"t":52.7,"en":"That was quick!","cn":"真快啊！"},{"t":54.73,"en":"Have you finished already?","cn":"你已经完成了吗？"},{"t":57.48,"en":"Yes.","cn":"是的。"},{"t":58.64,"en":"Look out of the window.","cn":"看看窗外的风景吧。"},{"t":61.35,"en":"It's raining!","cn":"下雨了！"},{"t":63.46,"en":"That means you don't need to water the garden.","cn":"这意味着你不需要给花园浇水了。"},{"t":68.8,"en":"That was a pleasant surprise.","cn":"这真是个令人愉快的惊喜。"},{"t":72.29,"en":"It means I can have tea, instead.","cn":"这意味着我可以喝茶来代替（之前的选择）。"}],"words":[{"word":"water","phonetic":["'wɔ:tə"],"pos":"v.","meaning":"浇水","us":"media/words/nce1/w0286_a.mp3","uk":"media/words/nce1/w0286_e.mp3"},{"word":"terribly","phonetic":["'terəbli"],"pos":"ad.","meaning":"非常","us":"media/words/nce1/w0789_a.mp3","uk":"media/words/nce1/w0789_e.mp3"},{"word":"dry","phonetic":["drai"],"pos":"a.","meaning":"干燥的，干的","us":"media/words/nce1/w0790_a.mp3","uk":"media/words/nce1/w0790_e.mp3"},{"word":"nuisance","phonetic":["'nju:səns"],"pos":"n.","meaning":"讨厌的东西或人","us":"media/words/nce1/w0791_a.mp3","uk":"media/words/nce1/w0791_e.mp3"},{"word":"mean","phonetic":["mi:n"],"pos":"v.","meaning":"意味着，意思是","us":"media/words/nce1/w0792_a.mp3","uk":"media/words/nce1/w0792_e.mp3"},{"word":"surprise","phonetic":["sə'praiz"],"pos":"n.","meaning":"惊奇，意外的事","us":"media/words/nce1/w0793_a.mp3","uk":"media/words/nce1/w0793_e.mp3"},{"word":"immediately","phonetic":["i'mi:diətli"],"pos":"ad.","meaning":"立即地","us":"media/words/nce1/w0794_a.mp3","uk":"media/words/nce1/w0794_e.mp3"}]}